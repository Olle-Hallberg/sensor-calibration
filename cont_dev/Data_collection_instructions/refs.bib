@Article{s25247691,
AUTHOR = {Yan, Yang and Mijiddorj, Lkhanaajav and Beringer, Tyler and Mijiddorj, Bilguunzaya and Ho, Alex and Weng, Binbin},
TITLE = {Machine Learning-Enhanced NDIR Methane Sensing Solution for Robust Outdoor Continuous Monitoring Applications},
JOURNAL = {Sensors},
VOLUME = {25},
YEAR = {2025},
NUMBER = {24},
ARTICLE-NUMBER = {7691},
URL = {https://www.mdpi.com/1424-8220/25/24/7691},
PubMedID = {41471686},
ISSN = {1424-8220},
ABSTRACT = {This work presents the development of a low-cost and high-performance multi-sensory gas detection instrument named the AIMNet Sensor, with the integration of a machine learning-based data processing method. The compact and low-power instrument (8.5 × 11.5 cm, 1.4 W) houses the core sensing hardware module, Senseair K96, that integrates both a non-dispersive infrared (NDIR)-based gas sensing unit and a BME280 environmental sensing unit. To address the outdoor operation challenges caused by environmental fluctuation due to the varying temperature, humidity, and pressure, from the software aspect, multiple machine learning-based regression models were trained in this work on 13,125 calibration data points collected under controlled laboratory conditions. Among ten tested algorithms, the Multilayer Perceptron (MLP) and Elastic Net models achieved the highest accuracy, with R-squared coefficient R2>0.8 on both indoor and outdoor scenarios, and with inter-sensor root mean square error (RMSE) within 1.5 ppm across four identical instruments. Moreover, field mobile validation was performed near a wastewater management facility using this solution, confirming a strong correlation with LI-COR reference measurements and a reliable detection of CH4 leaks with concentrations up to 18 ppm at the test site. Overall, this machine learning-integrated NDIR sensing solution (i.e., AIMNet) offers a practical and scalable solution towards a more robust distributed CH4 monitoring network for real-world field-deployable applications.},
DOI = {10.3390/s25247691}
}

@misc{Olle2078608,
   author = {Olle, Hallberg and Albin, Zetterquist},
   institution = {Uppsala University, Department of Materials Science and Engineering},
   pages = {35},
   school = {Uppsala University, Department of Materials Science and Engineering},
   school = {Uppsala University, Department of Materials Science and Engineering},
   title = {Calibration of an NDIR GasSensor for Stratospheric Pressureand Temperature Conditions : A Project within MIRAGE (Methane InfraRed GasAbsorption Experiment)},
   series = {MATVET-F},
   series = {MATVET-Q},
   number = {26044},
   number = {26004},
   keywords = {greenhouse gases, NDIR gas sensor, machine learning},
   abstract = {Accurate measurements of methane and carbon dioxide are important for atmospheric research and climate modelling, but high-precision instruments are often expensive, complex, and unsuitable for compact balloon-borne experiments. This project investigated the calibration of the K96 NDIR gas sensor for use in the MIRAGE Experiment, under pressure, temperature and humidity conditions relevant for stratospheric operation. Calibration data were collected in a custom pressure chamber where the K96 was exposed to controlled variations in gas composition and environmental conditions. The selected input features were the three optical signal channels from the K96, relative pressure, temperature, and relative humidity. Methane and carbon dioxide molar fractions were used as target variables. Several calibration methods were evaluated, including XGBoost, a feedforward neural network, radial basis function interpolation, and nearest-neighbour interpolation. The results showed that data-driven calibration can substantially improve the predictive performance of the K96. XGBoost gave the best overall performance, with an R2 score of 0.9989 and a mean absolute error of 0.0012 ppm for methane, and an R2 score of 0.9991 and a mean absolute error of 0.1251 ppm for carbon dioxide. The feedforward neural network also performed well, while the interpolation methods were less accurate. However, since the final evaluation was based on a combined dataset split into training and test subsets, the results should be interpreted as a proof of concept rather than a complete validation. Further evaluation using independent reference measurements is required before the calibration can be considered fully verified for the MIRAGE experiment. },
   year = {2026}
}